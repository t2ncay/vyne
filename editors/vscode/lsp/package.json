{
  "name": "vyne-language-support",
  "displayName": "Vyne Language Support",
  "description": "Language Support for Vyne",
  "publisher": "Tuncay",
  "version": "0.2.5",
  "author": "Tuncay",
  "license": "MIT",
  "icon": "vyneLogo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/t2ncay/vyne.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./client/src/extension.js",
  "activationEvents": [
    "onLanguage:vyne"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vyne",
        "aliases": [
          "Vyne",
          "vyne"
        ],
        "extensions": [
          ".vy",
          ".vyne"
        ],
        "configuration": "./client/language-configuration.json",
        "icon": {
          "light": "./vyneLogo.png",
          "dark": "./vyneLogo.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "vyne",
        "scopeName": "source.vyne",
        "path": "./client/syntaxes/vyne.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "postinstall": "cd client && npm install"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  }
}
