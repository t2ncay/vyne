{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vyne",
  "scopeName": "source.vyne",
  "fileTypes": ["vy", "vyne"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#ruleset" },
    { "include": "#imports" },
    { "include": "#function-declaration" },
    { "include": "#interface-declaration" },
    { "include": "#group-declaration" },
    { "include": "#enum-declaration" },
    { "include": "#module-declaration" },
    { "include": "#exception-handlers" },
    { "include": "#control-keywords" },
    { "include": "#storage-modifiers" },
    { "include": "#builtin-functions" },
    { "include": "#builtin-modules" },
    { "include": "#constants" },
    { "include": "#builtin-types" },
    { "include": "#type-annotation" },
    { "include": "#generic-invocation" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#module-receiver" },
    { "include": "#member-access" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [{ "name": "comment.line.number-sign.vyne", "match": "#.*$" }]
    },

    "ruleset": {
      "patterns": [
        {
          "name": "meta.ruleset.vyne",
          "begin": "\\b(ruleset)\\b",
          "end": "(?=;|\\})",
          "beginCaptures": {
            "1": { "name": "storage.type.ruleset.vyne" }
          },
          "patterns": [
            { "include": "#ruleset-flags" },
            { "include": "#ruleset-values" }
          ]
        },
        {
          "name": "meta.ruleset.vyne",
          "match": "\\bruleset\\s+([a-z_][a-zA-Z0-9_]*)\\s*;",
          "captures": {
            "0": { "name": "storage.type.ruleset.vyne" },
            "1": { "name": "support.constant.ruleset.vyne" }
          }
        }
      ]
    },

    "ruleset-flags": {
      "patterns": [
        {
          "name": "support.constant.ruleset.vyne",
          "match": "\\b(warnings|dynamic_casting|memory_limit|strict|pedantic|verbose|debug|trace|profiling|type_check|implicit_casting|max_iterations|max_iter)\\b"
        }
      ]
    },

    "ruleset-values": {
      "patterns": [
        {
          "name": "support.constant.ruleset-value.vyne",
          "match": "\\b(all|none|error_only|hybrid|dynamic|warn|allow|deny|on|off|true|false)\\b"
        }
      ]
    },

    "imports": {
      "patterns": [
        {
          "name": "meta.import.vyne",
          "match": "\\b(use)\\s+(lib\\s+)?(\"(?:[^\"\\\\]|\\\\.)*\")(?:\\s+(as)\\s+([a-zA-Z_][a-zA-Z0-9_]*))?\\s*;?",
          "captures": {
            "1": { "name": "keyword.control.import.vyne" },
            "2": { "name": "storage.modifier.lib.vyne" },
            "3": { "name": "string.quoted.double.path.vyne" },
            "4": { "name": "keyword.control.as.vyne" },
            "5": { "name": "entity.name.namespace.alias.vyne" }
          }
        },
        {
          "name": "meta.deploy.vyne",
          "match": "\\b(deploy|dismiss)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*;",
          "captures": {
            "1": { "name": "keyword.control.module-lifecycle.vyne" },
            "2": { "name": "entity.name.namespace.vyne" }
          }
        }
      ]
    },

    "function-declaration": {
      "patterns": [
        {
          "name": "meta.function.vyne",
          "begin": "\\b(fn)\\s+(?:::)?\\s*([a-zA-Z_][a-zA-Z0-9_]*)?\\s*([a-zA-Z_][a-zA-Z0-9_]*)?",
          "end": "(?=\\{)",
          "beginCaptures": {
            "1": { "name": "storage.type.function.vyne" },
            "2": { "name": "entity.name.namespace.vyne" },
            "3": { "name": "entity.name.function.vyne" }
          },
          "patterns": [
            { "include": "#generic-params" },
            { "include": "#parameters" },
            { "include": "#return-arrow" }
          ]
        }
      ]
    },

    "interface-declaration": {
      "patterns": [
        {
          "name": "meta.interface.vyne",
          "begin": "\\b(interface)\\s+([A-Z][a-zA-Z0-9_]*)",
          "end": "(?=\\{)",
          "beginCaptures": {
            "1": { "name": "storage.type.interface.vyne" },
            "2": { "name": "entity.name.type.interface.vyne" }
          },
          "patterns": [
            { "include": "#generic-params" },
            {
              "name": "meta.interface-parent.vyne",
              "match": "(::)\\s*([A-Z][a-zA-Z0-9_.]*)",
              "captures": {
                "1": { "name": "keyword.operator.injection.vyne" },
                "2": { "name": "entity.name.namespace.vyne" }
              }
            }
          ]
        }
      ]
    },

    "group-declaration": {
      "patterns": [
        {
          "name": "meta.group.vyne",
          "begin": "\\b(group)(?:\\s+(::)\\s*([a-zA-Z_][a-zA-Z0-9_]*))?\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "end": "(?=\\{)",
          "beginCaptures": {
            "1": { "name": "storage.type.group.vyne" },
            "2": { "name": "keyword.operator.injection.vyne" },
            "3": { "name": "entity.name.namespace.vyne" },
            "4": { "name": "entity.name.type.group.vyne" }
          }
        }
      ]
    },

    "enum-declaration": {
      "patterns": [
        {
          "name": "meta.enum.vyne",
          "begin": "\\b(enum)\\s+([A-Z][a-zA-Z0-9_]*)",
          "end": "(?=\\{)",
          "beginCaptures": {
            "1": { "name": "storage.type.enum.vyne" },
            "2": { "name": "entity.name.type.enum.vyne" }
          }
        }
      ]
    },

    "module-declaration": {
      "patterns": [
        {
          "name": "meta.module.vyne",
          "match": "\\b(module)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*;",
          "captures": {
            "1": { "name": "storage.type.module.vyne" },
            "2": { "name": "entity.name.namespace.vyne" }
          }
        }
      ]
    },

    "exception-handlers": {
      "patterns": [
        {
          "name": "keyword.control.exception.vyne",
          "match": "\\b(try|catch|finally|throw)\\b"
        }
      ]
    },

    "control-keywords": {
      "patterns": [
        {
          "name": "keyword.control.vyne",
          "match": "\\b(if|else|while|through|return|break|continue|in)\\b"
        },
        {
          "name": "keyword.control.loop-mode.vyne",
          "match": "\\b(loop|collect|every|filter|unique)\\b"
        }
      ]
    },

    "storage-modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.const.vyne",
          "match": "\\bconst\\b"
        },
        {
          "name": "storage.modifier.defer.vyne",
          "match": "\\bdefer\\b"
        }
      ]
    },

    "builtin-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.vyne",
          "match": "\\b(out|sizeof|type|string|int64|float64|sequence|exit|free|map)\\b(?=\\s*\\()"
        }
      ]
    },

    "builtin-modules": {
      "patterns": [
        {
          "name": "support.constant.builtin-module.vyne",
          "match": "\\b(vcore|vglib|vaudio|vmem|vmath|vfs|vcv|vurage|vnet|vserv|vml)\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.vyne",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.vyne",
          "match": "\\bnull\\b"
        },
        {
          "name": "variable.language.self.vyne",
          "match": "\\bself\\b"
        }
      ]
    },

    "builtin-types": {
      "patterns": [
        {
          "name": "support.type.primitive.vyne",
          "match": "\\b(Int64|Float64|String|Array|Bool|Map|Null|Function|Module|Reference)\\b"
        }
      ]
    },

    "type-annotation": {
      "patterns": [
        {
          "name": "meta.type-annotation.vyne",
          "match": "(::)\\s*([A-Za-z_][a-zA-Z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.operator.type-annotation.vyne" },
            "2": { "name": "entity.name.type.vyne" }
          }
        }
      ]
    },

    "generic-invocation": {
      "patterns": [
        {
          "name": "meta.generic.vyne",
          "begin": "\\b([A-Z][A-Za-z0-9_]*)(<)",
          "end": ">",
          "beginCaptures": {
            "1": { "name": "entity.name.type.generic.vyne" },
            "2": { "name": "punctuation.definition.generic.begin.vyne" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.generic.end.vyne" }
          },
          "patterns": [
            { "include": "#builtin-types" },
            {
              "name": "entity.name.type.generic-arg.vyne",
              "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.generic.vyne",
              "match": ","
            },
            {
              "name": "punctuation.definition.generic.begin.vyne",
              "match": "<"
            },
            {
              "name": "punctuation.definition.generic.end.vyne",
              "match": ">"
            }
          ]
        }
      ]
    },

    "generic-params": {
      "patterns": [
        {
          "name": "meta.generic-params.vyne",
          "begin": "<",
          "end": ">",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.generic.begin.vyne" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.generic.end.vyne" }
          },
          "patterns": [
            {
              "name": "entity.name.type.generic-param.vyne",
              "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.generic.vyne",
              "match": ","
            }
          ]
        }
      ]
    },

    "parameters": {
      "patterns": [
        {
          "name": "meta.parameters.vyne",
          "begin": "\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": { "name": "punctuation.section.parameters.begin.vyne" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.parameters.end.vyne" }
          },
          "patterns": [
            {
              "name": "variable.parameter.vyne",
              "match": "\\b[a-z_][a-zA-Z0-9_]*\\b(?=\\s*(?:::|\\)|,|&))"
            },
            { "include": "#type-annotation" },
            { "include": "#builtin-types" },
            { "include": "#generic-params" },
            {
              "name": "punctuation.separator.parameter.vyne",
              "match": ","
            }
          ]
        }
      ]
    },

    "return-arrow": {
      "patterns": [
        {
          "name": "meta.return-type.vyne",
          "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.operator.return-type.vyne" },
            "2": { "name": "entity.name.type.return.vyne" }
          }
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vyne",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.vyne" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.vyne" }
          },
          "patterns": [
            { "include": "#string-interpolation" },
            {
              "name": "constant.character.escape.vyne",
              "match": "\\\\(?:[ntre\"\\\\{}]|[0-7]{1,3})"
            }
          ]
        }
      ]
    },

    "string-interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.expression.vyne",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.vyne" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.vyne" }
          },
          "patterns": [
            { "include": "#builtin-functions" },
            { "include": "#constants" },
            { "include": "#numbers" },
            { "include": "#operators" },
            { "include": "#function-call" },
            { "include": "#member-access" },
            { "include": "#identifiers" }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.vyne",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.vyne",
          "match": "\\b\\d+\\b"
        }
      ]
    },

    "module-receiver": {
      "patterns": [
        {
          "name": "entity.name.namespace.vyne",
          "match": "\\b[A-Z][A-Za-z0-9_]*(?=\\.[a-z_][A-Za-z0-9_]*\\s*\\()"
        }
      ]
    },

    "member-access": {
      "patterns": [
        {
          "name": "meta.member-access.vyne",
          "match": "\\.\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "0": { "name": "meta.member.vyne" },
            "1": { "name": "variable.other.member.vyne" }
          }
        }
      ]
    },

    "function-call": {
      "patterns": [
        {
          "name": "meta.function-call.vyne",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.vyne" }
          }
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.null-coalesce.vyne",
          "match": "\\?\\?=|\\?\\?"
        },
        {
          "name": "keyword.operator.pipeline.vyne",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.vyne",
          "match": "->"
        },
        {
          "name": "keyword.operator.injection.vyne",
          "match": "::"
        },
        {
          "name": "keyword.operator.range.vyne",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.logical.vyne",
          "match": "&&|\\|\\||==|!=|>=|<=|!|<|>"
        },
        {
          "name": "keyword.operator.assignment.vyne",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.vyne",
          "match": "\\+\\+|--|\\*\\*|//|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.reference.vyne",
          "match": "&|\\$"
        },
        {
          "name": "keyword.operator.ternary.vyne",
          "match": "\\?"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.colon.vyne",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.vyne",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.vyne",
          "match": ","
        },
        {
          "name": "punctuation.accessor.vyne",
          "match": "\\."
        },
        {
          "name": "punctuation.section.bracket.vyne",
          "match": "[(){}\\[\\]]"
        }
      ]
    },

    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.vyne",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "entity.name.type.vyne",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
