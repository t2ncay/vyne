{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vyne",
  "scopeName": "source.vyne",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#storage_types" },
    { "include": "#modules" },
    { "include": "#operators" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.vyne",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vyne",
          "match": "\\b(if|else|while|return|dismiss|break|continue|through|as|use|lib|loop|collect|every|filter|unique|in)\\b"
        }
      ]
    },
    "storage_types": {
      "patterns": [
        {
          "name": "storage.type.function.vyne",
          "match": "\\bfn\\b"
        },
        {
          "name": "storage.type.vyne",
          "match": "\\b(group|interface|enum|module)\\b"
        },
        {
          "name": "keyword.other.vyne",
          "match": "\\b(deploy|ruleset)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.vyne",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.vyne",
          "match": "\\bnull\\b"
        },
        {
          "name": "storage.modifier.vyne",
          "match": "\\bconst\\b"
        },
        {
          "name": "variable.language.self.vyne",
          "match": "\\bself\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.vyne",
          "match": "(&&|\\|\\||==|!=|>=|<=|>|<|!)"
        },
        {
          "name": "keyword.operator.range.vyne",
          "match": "(\\.\\.|::|->|\\|>)"
        },
        {
          "name": "keyword.operator.assignment.vyne",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.vyne",
          "match": "(\\+|\\-|\\*|\\/|\\%|\\*\\*|\\+\\+|\\-\\-)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.vyne",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.vyne",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.vyne",
          "match": "\\\\."
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "name": "support.function.vyne",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "support.type.vyne",
          "match": "\\b(vcore|vglib|vaudio|vmem|vmath|vfs|vcv|vurage|vnet|vserv|warnings|dynamic_casting|memory_limit|String|Array|Number|Int64|Float64|Map)\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.vyne",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
