{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vyne",
  "scopeName": "source.vyne",
  "fileTypes": ["vy", "vyne"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#storage_types" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#builtin_functions" },
    { "include": "#modules" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.vyne",
          "match": "#.*$"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vyne",
          "match": "\\b(if|else|while|through|loop|collect|every|filter|unique|return|break|continue|in)\\b"
        },
        {
          "name": "keyword.control.exception.vyne",
          "match": "\\b(try|catch|finally|throw)\\b"
        },
        {
          "name": "keyword.control.defer.vyne",
          "match": "\\bdefer\\b"
        },
        {
          "name": "keyword.other.import.vyne",
          "match": "\\b(use|lib|as|deploy|dismiss)\\b"
        },
        {
          "name": "keyword.other.ruleset.vyne",
          "match": "\\b(ruleset|warnings|dynamic_casting|memory_limit|strict|pedantic|verbose)\\b"
        }
      ]
    },

    "storage_types": {
      "patterns": [
        {
          "name": "storage.type.function.vyne",
          "match": "\\bfn\\b"
        },
        {
          "name": "storage.type.vyne",
          "match": "\\b(group|interface|enum|module)\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.vyne",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.vyne",
          "match": "\\bnull\\b"
        },
        {
          "name": "storage.modifier.vyne",
          "match": "\\bconst\\b"
        },
        {
          "name": "variable.language.self.vyne",
          "match": "\\bself\\b"
        }
      ]
    },

    "builtin_functions": {
      "patterns": [
        {
          "name": "support.function.builtin.vyne",
          "match": "\\b(out|sizeof|type|string|int64|float64|sequence|exit|free)\\b(?=\\s*\\()"
        }
      ]
    },

    "modules": {
      "patterns": [
        {
          "name": "support.function.vyne",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "support.type.module.vyne",
          "match": "\\b(vcore|vglib|vaudio|vmem|vmath|vfs|vcv|vurage|vnet|vserv|vml)\\b"
        },
        {
          "name": "support.type.primitive.vyne",
          "match": "\\b(Int64|Float64|String|Array|Bool|Map|Null|Function|Module)\\b"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vyne",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string_interpolation" },
            {
              "name": "constant.character.escape.vyne",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "string_interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.vyne",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#keywords" },
            { "include": "#operators" },
            { "include": "#numbers" },
            { "include": "#constants" },
            { "include": "#variables" }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.vyne",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.int.vyne",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.null-coalesce.vyne",
          "match": "\\?\\?=|\\?\\?"
        },
        {
          "name": "keyword.operator.pipeline.vyne",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.vyne",
          "match": "->"
        },
        {
          "name": "keyword.operator.scope.vyne",
          "match": "::"
        },
        {
          "name": "keyword.operator.range.vyne",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.logical.vyne",
          "match": "&&|\\|\\||==|!=|>=|<=|!|<|>"
        },
        {
          "name": "keyword.operator.assignment.vyne",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.vyne",
          "match": "\\+\\+|--|\\*\\*|//|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.reference.vyne",
          "match": "&|\\$"
        },
        {
          "name": "keyword.operator.ternary.vyne",
          "match": "\\?"
        },
        {
          "name": "punctuation.separator.vyne",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.vyne",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.vyne",
          "match": ","
        },
        {
          "name": "punctuation.accessor.vyne",
          "match": "\\."
        },
        {
          "name": "punctuation.bracket.vyne",
          "match": "[(){}\\[\\]]"
        }
      ]
    },

    "variables": {
      "patterns": [
        {
          "name": "variable.other.vyne",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
