*.vy linguist-language=C++

# Serialized resources use LF delimiters on every platform, including Windows CI.
*.vshader text eol=lf
*.vgraph text eol=lf
*.vpipeline text eol=lf
*.vpipeline.host text eol=lf
*.vmaterial text eol=lf

# GLSL companions must match serialized source bytes and dependency hashes.
*.glsl text eol=lf
*.fs text eol=lf
*.vs text eol=lf

# Keep the pinned upstream snapshot byte-for-byte, including upstream line endings.
vendor/raylib/** -text
