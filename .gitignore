# ESP32 hardware profiles are source configuration, not generated reports.
!vyne/runtime/esp32/profiles/*.json

# `share/vyne` holds compiler data: project templates, license texts, and
# bundled sample assets. Some of their extensions collide with the
# build-output ignores above, but they are source files.
!share/vyne/**
examples/test/*_build
examples/test/*_sketch
examples/test/*_cache

# Vendored build metadata and the binding coverage inventory are source files.
!vendor/raylib/**
!vyne/runtime/vraylib/CMakeLists.txt
!vyne/runtime/vraylib/api.json
