use "../src/shader/pipeline.vy";
fn sp_check(ok :: Bool,message :: String) -> Bool { if !ok { throw message; } return true; }
@bounded<33554432> region shader_pipeline_cpu {
    p :: SSPipeline := ss_pipeline(); ss_pipeline_add(p,10,1,-1,-2,0,0,1,1); ss_pipeline_add(p,20,1,10,-2,0,0,2,1); ss_pipeline_enable(p,10,true,true); ss_pipeline_validate(p);
    ss_pipeline_save(p,"build/shader-model-dev/roundtrip.vpipeline"); reopened :: SSPipeline := ss_pipeline(); ss_pipeline_load(reopened,"build/shader-model-dev/roundtrip.vpipeline"); sp_check(ss_pipeline_text(p) == ss_pipeline_text(reopened),"pipeline descriptors/dependencies/capture roundtrip");
    sample :: SSPipeline := ss_pipeline(); ss_pipeline_load(sample,"examples/projects/vmge/shaders/studio/gain.vpipeline"); sp_check(sample.state[0] == 2,"shipped pipeline resource loads");
    failed :: Bool := false; p.meta[12] = 20; try { ss_pipeline_validate(p); } catch (error) { failed = true; } sp_check(failed,"write feedback rejected");
    p.meta[12] = 10; p.meta[2] = 20; failed = false; try { ss_pipeline_validate(p); } catch (error) { failed = true; } sp_check(failed,"pipeline cycle rejected");
    p.meta[2] = 999; failed = false; try { ss_pipeline_validate(p); } catch (error) { failed = true; } sp_check(failed,"missing pass rejected");
    failed = false; try { ss_pipeline_parse(reopened,"VMGE_PIPELINE|99\n"); } catch (error) { failed = true; } sp_check(failed && reopened.state[0] == 2,"failed reopen preserves candidate-independent pipeline");
    rejected :: Int64 := 0; try { ss_pipeline_reflected_inputs([["inputTexture",5126,1,0]]); } catch (error) { rejected = rejected+1; } try { ss_pipeline_reflected_inputs([["inputTexture",35678,1,-1]]); } catch (error) { rejected = rejected+1; } try { ss_pipeline_reflected_inputs([["inputTexture[0]",35678,1,0]]); } catch (error) { rejected = rejected+1; } sp_check(rejected == 3 && ss_pipeline_reflected_inputs([["inputTexture",35678,1,0],["inputTexture1",35678,1,1]]) == 3,"controlled inputs require active scalar sampler reflection");
    sample.meta[17] = 0; failed = false; try { ss_pipeline_validate(sample); } catch (error) { failed = true; } sp_check(failed,"direct invalid resolution divisor rejected during preflight");
};
out("VMGE_SHADER_PIPELINE_CPU_OK");
if vraylib.environment("VYNE_SHADER_GPU") == "1" {
    app :: vraylib.App := vraylib.app_options(64,64,"Shader pipeline GPU",0,vraylib.FLAG_WINDOW_HIDDEN);
    try {
        d :: SSDocument := ss_document(); se_text_write(d.source,vfs.read("examples/projects/vmge/shaders/studio/gain.fs")); se_text_write(d.fragment_path,"examples/projects/vmge/shaders/studio/gain.fs"); ss_document_source_change(d); sp_check(ss_compile(app,d),"pipeline compile: "+se_text_read(d.log));
        docs :: Array := [d]; ids :: Array<Int64> := [1]; p :: SSPipeline := ss_pipeline(); ss_pipeline_add(p,10,1,-1,-2,0,0,1,1); ss_pipeline_add(p,20,1,10,-2,0,0,2,1); ss_pipeline_enable(p,10,true,true); ss_pipeline_prepare(app,p,32,32); input_target :: vraylib.RenderTarget := app.float_target(32,32);
        dual :: SSDocument := ss_document(); dual.parameters.state[0] = 0; se_text_write(dual.source,"#version 330\nin vec2 fragTexCoord;\nout vec4 finalColor;\nuniform sampler2D inputTexture;\nuniform sampler2D inputTexture1;\nvoid main()\{finalColor=0.5*(texture(inputTexture,fragTexCoord)+texture(inputTexture1,fragTexCoord));}\n"); ss_document_source_change(dual); sp_check(ss_compile(app,dual),"dual-input shader compiles");
        wrong :: SSDocument := ss_document(); wrong.parameters.state[0] = 0; se_text_write(wrong.source,"#version 330\nout vec4 finalColor;\nuniform vec4 inputTexture;\nvoid main()\{finalColor=inputTexture;}\n"); ss_document_source_change(wrong); sp_check(ss_compile(app,wrong),"wrong controlled uniform type fixture compiles");
        array_doc :: SSDocument := ss_document(); array_doc.parameters.state[0] = 0; se_text_write(array_doc.source,"#version 330\nin vec2 fragTexCoord;\nout vec4 finalColor;\nuniform sampler2D inputTexture[1];\nvoid main()\{finalColor=texture(inputTexture[0],fragTexCoord);}\n"); ss_document_source_change(array_doc); sp_check(ss_compile(app,array_doc),"sampler[1] fixture compiles");
        registry :: Array := [d,dual,wrong,array_doc]; registry_ids :: Array<Int64> := [1,2,3,4]; q :: SSPipeline := ss_pipeline(); ss_pipeline_add(q,10,1,-1,-2,0,0,1,1); ss_pipeline_add(q,20,2,10,-2,0,0,1,1); ss_pipeline_prepare(app,q,8,8);
        identity :: SSDocument := ss_document(); identity.parameters.state[0] = 0; se_text_write(identity.source,"#version 330\nin vec2 fragTexCoord;\nout vec4 finalColor;\nuniform sampler2D inputTexture;\nvoid main()\{finalColor=texture(inputTexture,fragTexCoord);}\n"); ss_document_source_change(identity); sp_check(ss_compile(app,identity),"identity copy shader compiles"); identity_docs :: Array := [identity]; identity_ids :: Array<Int64> := [1]; copies :: SSPipeline := ss_pipeline(); ss_pipeline_add(copies,1,1,-1,-2,0,0,1,1); ss_pipeline_add(copies,2,1,1,-2,0,0,1,1); ss_pipeline_prepare(app,copies,8,8);
        app.limit(3); while app.frame() {
            input_target.begin(); app.clear(vraylib.WHITE); input_target.end(); output :: vraylib.RenderTarget := ss_pipeline_run(app,p,docs,ids,input_target); pixels :: Array<Float64> := output.read_pixel(8,8); sp_check(output.width() == 16 && vmath.abs(pixels[0]-0.25) < 0.001,"ordered float multipass output");
            intermediate :: Array<Float64> := ss_pipeline_capture(p,10); sp_check(vmath.abs(intermediate[0]-0.5) < 0.001,"intermediate capture");
            if app.frames() == 0 {
                old0 :: Int64 := p.tokens[0]; old1 :: Int64 := p.tokens[1]; old_output :: Int64 := p.outputs[1]; resources :: Int64 := app.resources(); old_size :: Int64 := p.state[4]; failed :: Bool := false;
                vraylib.RenderTarget(old0,app.token).begin(); try { ss_pipeline_prepare(app,p,40,40); } catch (error) { failed = true; } sp_check(failed && app.resources() == resources && p.tokens[0] == old0 && p.tokens[1] == old1 && p.outputs[1] == old_output && p.state[4] == old_size && vraylib.RenderTarget(old0,app.token).valid() && vraylib.RenderTarget(old1,app.token).valid(),"active old bank remains wholly valid with no candidate allocation or partial close"); vraylib.RenderTarget(old0,app.token).end();
                ss_program(d).set_texture("inputTexture",vraylib.RenderTarget(old1,app.token).texture()); failed = false; try { ss_pipeline_prepare(app,p,40,40); } catch (error) { failed = true; } sp_check(failed && app.resources() == resources && p.tokens[0] == old0 && p.tokens[1] == old1 && p.outputs[1] == old_output && vraylib.RenderTarget(old0,app.token).valid() && vraylib.RenderTarget(old1,app.token).valid(),"externally referenced second target blocks whole bank before allocation"); ss_program(d).set_texture("inputTexture",null);
                vraylib.RenderTarget(q.tokens[0],app.token).begin(); app.clear(vraylib.GREEN); vraylib.RenderTarget(q.tokens[0],app.token).end(); q.outputs[0] = q.tokens[0]; q.outputs[1] = q.tokens[1]; ss_program(dual).set_texture("inputTexture",input_target.texture()); ss_program(dual).set_texture("inputTexture1",input_target.texture()); failed = false;
                try { ss_pipeline_run(app,q,registry,registry_ids,input_target); } catch (error) { failed = true; } sentinel :: Array<Float64> := vraylib.RenderTarget(q.tokens[0],app.token).read_pixel(2,2); sp_check(failed && sentinel[1] > 0.89 && q.outputs[0] == q.tokens[0] && q.outputs[1] == q.tokens[1] && app.can_release([input_target.token]),"missing secondary descriptor rejected before first draw; both stale controlled bindings cleared");
                q.meta[13] = -1; q.state[1] = q.state[1]+1; ss_pipeline_prepare(app,q,8,8); dual_output :: vraylib.RenderTarget := ss_pipeline_run(app,q,registry,registry_ids,input_target); dual_pixel :: Array<Float64> := dual_output.read_pixel(2,2); sp_check(vmath.abs(dual_pixel[0]-0.75) < 0.001 && app.can_release([input_target.token]),"both supplied active sampler inputs draw and release their dependencies");
                q.meta[11] = 3; q.meta[13] = -2; q.state[1] = q.state[1]+1; ss_pipeline_prepare(app,q,8,8); failed = false; try { ss_pipeline_run(app,q,registry,registry_ids,input_target); } catch (error) { failed = true; } sp_check(failed && q.outputs[0] == 0 && q.outputs[1] == 0,"wrong controlled type rejected before pipeline output publication");
                q.meta[11] = 4; q.state[1] = q.state[1]+1; ss_pipeline_prepare(app,q,8,8); failed = false; try { ss_pipeline_run(app,q,registry,registry_ids,input_target); } catch (error) { failed = true; } sp_check(failed,"real sampler[1] controlled input rejected as non-scalar");
                q.meta[11] = 1; q.meta[13] = -1; q.state[1] = q.state[1]+1; ss_pipeline_prepare(app,q,8,8); failed = false; try { ss_pipeline_run(app,q,registry,registry_ids,input_target); } catch (error) { failed = true; } sp_check(failed,"supplied secondary descriptor requires an actual active inputTexture1");
                input_target.begin(); app.clear(vraylib.rgba(64,128,192,128)); vraylib.draw_rectangle(0,0,32,16,vraylib.RED); input_target.end(); opaque_source :: Array<Float64> := input_target.read_pixel(2,2); alpha_source :: Array<Float64> := input_target.read_pixel(2,24); copied :: vraylib.RenderTarget := ss_pipeline_run(app,copies,identity_docs,identity_ids,input_target); opaque_copy :: Array<Float64> := copied.read_pixel(2,2); alpha_copy :: Array<Float64> := copied.read_pixel(2,6);
                channel :: Int64 := 0; while channel < 4 { sp_check(alpha_copy[channel] == alpha_source[channel] && opaque_copy[channel] == opaque_source[channel],"two replacement identity passes preserve nonopaque RGBA and top-left orientation exactly"); channel = channel+1; }
            }
            if app.frames() == 2 {
                ss_pipeline_enable(p,20,false,false); ss_pipeline_prepare(app,p,32,32); output = ss_pipeline_run(app,p,docs,ids,input_target); sp_check(output.token == p.outputs[0] && output.width() == 32,"disabled pass aliases its input");
                ss_pipeline_prepare(app,p,48,24); sp_check(vraylib.RenderTarget(p.tokens[0],app.token).width() == 48 && vraylib.RenderTarget(p.tokens[1],app.token).height() == 12,"relative target resolution rebuild"); output = input_target;
            }
            app.begin(); output.present(64.0,64.0); app.end();
        }
        sp_check(p.meta[14] == 0 && p.state[4] == 48*8192+24,"bypass and rebuild phases actually executed");
        ss_pipeline_close(p); ss_pipeline_close(q); ss_pipeline_close(copies); input_target.close(); ss_document_close(d); ss_document_close(dual); ss_document_close(wrong); ss_document_close(array_doc); ss_document_close(identity); sp_check(app.resources() == 0,"pipeline releases targets and programs");
    } finally { app.close(); }
    out("VMGE_SHADER_PIPELINE_GPU_OK");
}
out("VMGE_SHADER_PIPELINE_OK");
