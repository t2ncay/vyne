    ss_check(ss_document_reload(d,true) && ss_parameter_get(d,1,0) == 0.9,"explicit discard reload");
    failed = false; try { ss_parameter_define(d,1,"duplicate",5126,1,0.0,0.0,1.0,"","",true,true); } catch (error) { failed = true; } ss_check(failed,"stable IDs unique");
    failed = false; try { ss_parameter_set(d,1,0,2.0); } catch (error) { failed = true; } ss_check(failed && ss_parameter_get(d,1,0) == 0.9,"range validated before mutation");
    vfs.write_atomic("build/shader-model-dev/malformed.vshader","VMGE_SHADER|1\nF|4142\nV|\nFP|\nVP|\nP|broken\n"); retained_source :: Int64 := ss_hash(d.source); retained_revision :: Int64 := d.state[0]; failed = false; try { ss_document_load(d,"build/shader-model-dev/malformed.vshader"); } catch (error) { failed = true; } ss_check(failed && ss_hash(d.source) == retained_source && d.state[0] == retained_revision,"malformed load cannot publish partial source or revisions");
    exact :: Float64 := 0.12345678901234567; ss_parameter_set(d,1,0,exact); ss_document_save(d,"build/shader-model-dev/exact.vshader"); ss_document_load(reopened,"build/shader-model-dev/exact.vshader"); ss_check(ss_parameter_get(reopened,1,0) == exact,"exact Float64 persistence");
    m :: MaterialInstance := ss_material(5,6); other :: MaterialInstance := ss_material(5,7); ss_material_migrate(m,d); ss_material_migrate(other,d); ss_material_set(m,1,0,0.2); ss_check(ss_material_get(other,1,0) == exact,"instance stores independent");
    ss_material_save(m,"build/shader-model-dev/roundtrip.vmaterial"); ss_material_load(other,"build/shader-model-dev/roundtrip.vmaterial"); ss_check(other.state[0] == 5 && other.state[1] == 6 && ss_material_get(other,1,0) == 0.2,"material IDs and overrides roundtrip");
    d.parameters.meta[1] = 35664; d.parameters.meta[3] = 2; ss_material_migrate(m,d); ss_check(m.state[2] == 2 && m.meta[4] == 0 && m.values[0] == 0.2,"incompatible material migration retains orphan");
    d.parameters.meta[1] = 5126; d.parameters.meta[3] = 1; ss_material_migrate(m,d); ss_check(ss_material_get(m,1,0) == 0.2,"compatible orphan restored by stable ID");
    prep :: SSPreprocessor := ss_preprocessor(); expanded :: String := ss_expand(prep,"#version 330\n#include \"common.glsl\"\nvoid main()\{}\n","examples/projects/vmge/shaders/studio/root.fs",0,0); ss_check(prep.state[0] == 1 && prep.hashes[0] != 0,"include dependency hash/source IDs");
    failed = false; try { ss_expand(ss_preprocessor(),"#version 330\n#include \"cycle-a.glsl\"\n","examples/projects/vmge/shaders/studio/root.fs",0,0); } catch (error) { failed = true; } ss_check(failed,"include cycle rejected");
    failed = false; try { ss_expand(ss_preprocessor(),"#version 330\n#include \"missing.glsl\"\n","examples/projects/vmge/shaders/studio/root.fs",0,0); } catch (error) { failed = true; } ss_check(failed,"missing include rejected");
    vfs.write_atomic("build/shader-model-dev/dependency.glsl","float dependency=1.0;\n"); live :: SSPreprocessor := ss_preprocessor(); ss_expand(live,"#version 330\n#include \"dependency.glsl\"\n","build/shader-model-dev/root.fs",0,0); se_text_copy(d.dependencies[0],live.paths[0]); d.dependency_hashes[0] = live.hashes[0]; d.state[10] = 1;
    ss_check(!ss_document_dependencies_changed(d),"unchanged dependency clean"); disk_dirty :: Bool := ss_document_dirty(d); vfs.write_atomic("build/shader-model-dev/dependency.glsl","float dependency=2.0;\n"); ss_check(ss_document_dependencies_changed(d) && !ss_document_dependencies_changed(d) && ss_document_dirty(d) == disk_dirty,"external include changes advance build revision once without making root resource dirty");
    small :: MaterialInstance := ss_material_sized(5,8,16,16); ss_material_copy(small,m); ss_check(small.meta.size() == 80 && small.values.size() == 1024 && small.bindings.size() == 64 && ss_material_get(small,1,0) == 0.2,"host 16/16 material copies actual live rows including orphans"); ss_material_copy(small,small); ss_check(ss_material_get(small,1,0) == 0.2,"material self-copy retains live rows");
    ss_material_save(small,"build/shader-model-dev/small.vmaterial"); tiny :: MaterialInstance := ss_material_sized(5,9,1,0); failed = false; try { ss_material_load(tiny,"build/shader-model-dev/small.vmaterial"); } catch (error) { failed = true; } ss_check(failed && tiny.state[2] == 0 && tiny.state[1] == 9,"sized parse capacity rejected before publication");
    ss_material_migrate(tiny,d); d.parameters.meta[1] = 35664; d.parameters.meta[3] = 2; original_value :: Float64 := ss_parameter_get(d,1,0); original_edit :: Int64 := d.state[0]; failed = false; try { ss_material_parameter_set(d,tiny,1,0,0.4); } catch (error) { failed = true; } ss_check(failed && d.state[0] == original_edit && ss_parameter_get(d,1,0) == original_value && tiny.state[2] == 1,"coupled edit stages migration before touching document or undersized material");
    d.parameters.meta[1] = 5126; d.parameters.meta[3] = 1; ss_material_parameter_set(d,tiny,1,0,0.4); ss_check(ss_parameter_get(d,1,0) == 0.4 && ss_material_get(tiny,1,0) == 0.4,"validated coupled document/material edit publishes both");
    fresh :: MaterialInstance := ss_material_sized(5,10,16,0); ss_check(ss_material_parameter_set(d,fresh,1,0,0.4) && fresh.state[2] == 1,"coupled edit reports newly migrated material even when document value is unchanged");
    numeric :: SSDocument := ss_document(); numeric.parameters.state[0] = 0; ss_parameter_define(numeric,9,"integer",5124,1,0.0,-2147483648.0,2147483647.0,"","",false,false); ss_parameter_set(numeric,9,0,-2147483648.0); ss_parameter_define(numeric,10,"bits",35671,1,1.0,0.0,1.0,"","",false,false);
    failures :: Int64 := 0; try { ss_parameter_set(numeric,9,0,2147483648.0); } catch (error) { failures = failures+1; } try { ss_parameter_set(numeric,9,0,0.5); } catch (error) { failures = failures+1; } try { ss_parameter_set(numeric,10,1,2.0); } catch (error) { failures = failures+1; } try { ss_parameter_default_set(numeric,10,1,0.5); } catch (error) { failures = failures+1; } try { ss_parameter_define(numeric,11,"badbool",35670,1,0.5,0.0,1.0,"","",false,false); } catch (error) { failures = failures+1; }
    ss_check(failures == 5 && ss_parameter_get(numeric,9,0) == -2147483648.0,"shared type validation: signed Int32 and exact boolean define/set/default"); ss_document_save(numeric,"build/shader-model-dev/int32.vshader"); ss_document_load(reopened,"build/shader-model-dev/int32.vshader"); ss_check(ss_parameter_get(reopened,9,0) == -2147483648.0,"full signed Int32 persists exactly");
    invalid_defaults :: String := "VMGE_SHADER|1\nF|41\nV|\nFP|\nVP|\nP|10|62697473|35671|1|0|1|||0|0|1|1|2|1\n"; vfs.write_atomic("build/shader-model-dev/invalid-defaults.vshader",invalid_defaults); failed = false; try { ss_document_load(reopened,"build/shader-model-dev/invalid-defaults.vshader"); } catch (error) { failed = true; } ss_check(failed && ss_parameter_get(reopened,9,0) == -2147483648.0,"non-first default component validated before load publishes");
    numeric_material :: MaterialInstance := ss_material_sized(1,1,16,0); ss_material_migrate(numeric_material,numeric); failed = false; try { ss_material_set(numeric_material,10,1,2.0); } catch (error) { failed = true; } ss_check(failed,"material setter uses exact boolean validator"); failed = false; try { ss_material_parse(numeric_material,"VMGE_MATERIAL|1|1|1\nP|10|35671|1|2|1|1|2\n"); } catch (error) { failed = true; } ss_check(failed && numeric_material.state[2] == 2,"material parser validates every boolean component before publication");
    reflected :: SSDocument := ss_document(); ss_parameter_define(reflected,2,"tex",35678,1,0.0,0.0,1.0,"","",false,false); ss_reflect(reflected.parameters,[["gain",5126,1,-1],["tex[0]",35678,1,4]]); ss_check(reflected.parameters.meta[6] == 3 && reflected.parameters.meta[14] == 3,"negative uniform location and sampler[1] reflection are incompatible");
};
out("VMGE_SHADER_MODEL_CPU_OK");
if vraylib.environment("VYNE_SHADER_GPU") == "1" {
    app :: vraylib.App := vraylib.app_options(64,64,"Shader model GPU",0,vraylib.FLAG_WINDOW_HIDDEN);
    try {
        d :: SSDocument := ss_document(); left :: MaterialInstance := ss_material_sized(1,1,16,16); right :: MaterialInstance := ss_material_sized(1,2,16,16); ss_material_migrate(left,d); ss_material_migrate(right,d); ss_material_set(left,1,0,0.2); ss_material_set(right,1,0,0.8);
        ss_check(ss_compile(app,d),"initial real GPU compile: "+se_text_read(d.log)); old_token :: Int64 := d.state[4]; resources :: Int64 := app.resources();
        se_text_write(d.source,"#version 330\nthis is invalid GLSL\n"); ss_document_source_change(d); ss_check(!ss_compile(app,d) && d.state[4] == old_token && ss_program(d).valid() && app.resources() == resources,"failed GPU compile preserves old program/resources");
        se_text_write(d.source,"#version 330\nout vec4 finalColor;\nuniform float gain;\nvoid main()\{finalColor=vec4(vec3(gain),1.0);}\n"); ss_document_source_change(d); ss_check(ss_compile(app,d) && d.state[4] != old_token && !vraylib.Shader(old_token,app.token).valid() && app.resources() == resources,"uncached build publishes then releases old shader");
        ss_check(d.parameters.meta[6] == 1 && d.parameters.meta[7] >= 0,"actual reflection migration");
        image :: vraylib.Image := app.image(1,1,vraylib.WHITE); texture :: vraylib.Texture := app.texture(image); image.close(); model :: vraylib.Model := app.cube(texture); target :: vraylib.RenderTarget := app.float_target(64,64); camera :: vraylib.Camera := app.camera(vraylib.vec3(0.0,0.0,4.0),vraylib.vec3(0.0,0.0,0.0),60.0); camera.set_orthographic(4.0);
        linked_old :: Int64 := d.state[4]; model.set_shader(ss_program(d)); ss_check(ss_compile(app,d) && d.state[12] == 1 && vraylib.Shader(linked_old,app.token).valid(),"blocked old shader release retains dependency token"); model.set_shader(ss_program(d)); ss_check(ss_document_collect(d) && !vraylib.Shader(linked_old,app.token).valid(),"old shader released after dependency detaches");
        ss_parameter_set(d,1,0,0.6); ss_check(!ss_document_compile_dirty(d) && !ss_document_applied(d),"parameter values do not invalidate source build revision"); ss_parameter_set(d,1,0,0.5);
        typed :: SSDocument := ss_document(); typed.parameters.state[0] = 0;
        ss_parameter_define(typed,42,"weights",5126,3,0.0,0.0,1.0,"Typed","",true,false); ss_parameter_set(typed,42,0,0.1); ss_parameter_set(typed,42,1,0.2); ss_parameter_set(typed,42,2,0.3);
        ss_parameter_define(typed,43,"flags",35667,1,1.0,0.0,10.0,"Typed","",false,false); ss_parameter_set(typed,43,0,2.0); ss_parameter_set(typed,43,1,3.0);
        ss_parameter_define(typed,44,"switches",35671,1,1.0,0.0,1.0,"Typed","",false,false); ss_parameter_define(typed,45,"warp",35676,1,0.0,0.0,1.0,"Typed","",true,false); ss_parameter_set(typed,45,0,1.0);
        se_text_write(typed.source,"#version 330\nout vec4 finalColor;\nuniform float weights[3];\nuniform ivec2 flags;\nuniform bvec2 switches;\nuniform mat4 warp;\nvoid main()\{vec3 c=vec3(weights[0]+float(flags.x)*0.1,weights[1]+float(flags.y)*0.1,weights[2]);finalColor=vec4(c*(switches.x?1.0:0.0)*warp[0][0],1.0);}\n"); ss_document_source_change(typed); ss_check(ss_compile(app,typed),"typed array/int/bool/matrix GPU compile"); typed_material :: MaterialInstance := ss_material_sized(2,1,16,16); ss_material_migrate(typed_material,typed); typed_target :: vraylib.RenderTarget := app.float_target(8,8);
        blocked :: SSDocument := ss_document(); blocked.parameters.state[0] = 0; ss_parameter_define(blocked,1,"blocked",5126,1,0.0,0.0,1.0,"","",true,false); ss_parameter_define(blocked,2,"tex",35678,1,0.0,0.0,1.0,"","",false,false);
        se_text_write(blocked.source,"#version 330\nin vec2 fragTexCoord;\nout vec4 finalColor;\nlayout(std140) uniform Params\{float blocked;};\nuniform sampler2D tex[1];\nvoid main()\{finalColor=texture(tex[0],fragTexCoord)+vec4(blocked);}\n"); ss_document_source_change(blocked); ss_check(ss_compile(app,blocked) && blocked.parameters.meta[6] == 3 && blocked.parameters.meta[14] == 3,"real GPU block location -1 and sampler[1] excluded from active bindings");
        d.parameters.meta[1] = 35664; d.parameters.meta[3] = 2; ss_document_source_change(d); ss_material_migrate(left,d); ss_material_set(left,1,0,0.7); se_text_write(d.source,"#version 330\ninvalid draft\n"); ss_document_source_change(d); ss_check(!ss_compile(app,d) && ss_material_compatible_slot(left,1,5126,1) == 0 && left.meta[4] == 0,"failed new-type draft retains published scalar orphan override");
        app.limit(3); while app.frame() {
            target.begin(); app.clear(vraylib.BLACK); camera.begin();
            ss_material_draw(model,vraylib.math_matrix_translate(-0.8,0.0,0.0),d,left,0,vraylib.WHITE); ss_material_draw(model,vraylib.math_matrix_translate(0.8,0.0,0.0),d,right,0,vraylib.WHITE); camera.end(); target.end();
            a :: Array<Float64> := target.read_pixel(19,32); b :: Array<Float64> := target.read_pixel(45,32); ss_check(vmath.abs(a[0]-0.2) < 0.01 && vmath.abs(b[0]-0.8) < 0.01,"shared geometry uses independent per-draw materials");
            typed_target.begin(); app.clear(vraylib.BLACK); ss_material_apply(typed,typed_material); ss_program(typed).begin(); vraylib.draw_rectangle(0,0,8,8,vraylib.WHITE); ss_program(typed).end(); typed_target.end(); pixel :: Array<Float64> := typed_target.read_pixel(4,4); ss_check(vmath.abs(pixel[0]-0.3) < 0.001 && vmath.abs(pixel[1]-0.5) < 0.001 && vmath.abs(pixel[2]-0.3) < 0.001,"reflected typed uniform arrays/int/bool/mat4 uploaded correctly");
            bool_row :: Int64 := ss_material_slot(typed_material,44); weights_row :: Int64 := ss_material_slot(typed_material,42); typed_material.values[bool_row*64+1] = 2.0; typed_material.values[weights_row*64] = 0.9; failed :: Bool := false; try { ss_material_apply(typed,typed_material); } catch (error) { failed = true; } ss_check(failed,"invalid late boolean component rejected before any typed upload"); typed_material.values[bool_row*64+1] = 1.0; typed_material.values[weights_row*64] = 0.1;
            typed_target.begin(); app.clear(vraylib.BLACK); ss_program(typed).begin(); vraylib.draw_rectangle(0,0,8,8,vraylib.WHITE); ss_program(typed).end(); typed_target.end(); unchanged :: Array<Float64> := typed_target.read_pixel(4,4); ss_check(vmath.abs(unchanged[0]-0.3) < 0.001,"failed boolean preflight preserves prior GPU array uniforms");
            app.begin(); target.present(64.0,64.0); app.end();
        }
        model.close(); ss_document_close(d); ss_document_close(typed); ss_document_close(blocked); typed_target.close(); texture.close(); target.close(); camera.close(); ss_check(app.resources() == 0,"shader model GPU releases all handles");
    } finally { app.close(); }
    out("VMGE_SHADER_MODEL_GPU_OK");
}
out("VMGE_SHADER_MODEL_OK");
