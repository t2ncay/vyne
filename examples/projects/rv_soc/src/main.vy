# main.vy - train a small MLP on Iris. Generated by vynec init.
#
# Run from the project root so data/iris.data resolves:
#
#   vynec run src/main.vy

use native vcore;
use native vmath;
use external "vlin/vlin.vy";
use external "vml/vml.vy";
use external "vtermplot/vtermplot.vy";
use "models.vy";
use "data.vy";

ruleset { dynamic_casting };

vmath.seed(42);

out("=== rv_soc - Iris MLP ===");
out("");

ds :: data.Dataset := data.load_iris("data/iris.data");
out("dataset    : " + string(ds.n) + " samples, " +
    string(ds.features) + " features, " + string(ds.classes) + " classes");

hidden :: Int64 := 16;
epochs :: Int64 := 200;
base_lr :: Float64 := 0.01;

model :: models.MLP := models.make_mlp(ds.features, hidden, ds.classes);
W1 :: vlin.Types.Matrix := model.W1;
b1 :: Array<Float64> := model.b1;
W2 :: vlin.Types.Matrix := model.W2;
b2 :: Array<Float64> := model.b2;

opt :: vml.Types.Adam := vml.adam(base_lr);
state_W1 :: vml.Types.AdamState := vml.adam_state(hidden * ds.features);
state_W2 :: vml.Types.AdamState := vml.adam_state(ds.classes * hidden);

out("architecture: " + string(ds.features) + " -> " + string(hidden) +
    " -> " + string(ds.classes));
out("optimizer  : Adam lr=" + string(base_lr) + ", " + string(epochs) +
    " epochs");
out("");

xs :: Array<Float64> := [];
losses :: Array<Float64> := [];
t :: Int64 := 0;

through epoch :: 1..epochs -> loop {
    @bounded<1048576> region train_step {
        h :: Array := vml.forward_all_fused(model.seq, ds.X);
        A1 := h[0];
        A2 := h[1];

        # dL/dz2 for sigmoid + binary cross-entropy is (A2 - Y).
        delta2 := vlin.subtract(A2, ds.Y);
        dW2 := vlin.multiply_scalar(
            vlin.multiply(vlin.transpose(A1), delta2),
            1.0 / float64(ds.n)
        );

        delta1 := vlin.hadamard(
            vlin.multiply(delta2, vlin.transpose(W2)),
            vlin.tanh_prime(A1)
        );
        dW1 := vlin.multiply_scalar(
            vlin.multiply(vlin.transpose(ds.X), delta1),
            1.0 / float64(ds.n)
        );

        t = t + 1;
        vml.adam_step(W1, dW1, state_W1, opt, t);
        vml.adam_step(W2, dW2, state_W2, opt, t);

        bscale :: Float64 := opt.lr / float64(ds.n);
        through c :: 0..hidden-1 -> loop {
            db :: Float64 := 0.0;
            through r :: 0..ds.n-1 -> loop {
                db = db + delta1.data[r * hidden + c];
            };
            b1[c] = b1[c] - bscale * db;
        };
        through c2 :: 0..ds.classes-1 -> loop {
            db2 :: Float64 := 0.0;
            through r2 :: 0..ds.n-1 -> loop {
                db2 = db2 + delta2.data[r2 * ds.classes + c2];
            };
            b2[c2] = b2[c2] - bscale * db2;
        };
    };

    if epoch % 10 == 0 {
        h :: Array := vml.forward_all_fused(model.seq, ds.X);
        A2 := h[1];
        loss :: Float64 := vml.cross_entropy(A2, ds.Y);
        acc :: Float64 := models.accuracy_multi(A2, ds.Y, ds.n, ds.classes);
        xs.push(float64(epoch));
        losses.push(loss);
        out("epoch " + string(epoch) + "  loss " + string(loss) +
            "  acc " + string(acc));
    }
};

h_final :: Array := vml.forward_all_fused(model.seq, ds.X);
final_acc :: Float64 := models.accuracy_multi(
    h_final[1], ds.Y, ds.n, ds.classes
);

out("");
out("✓ Training complete. Accuracy: " + string(final_acc));
out("");

# A compact loss curve. Drop the plot if you are piping the output.
out(vtermplot.plot_line(xs, losses, 64, 14, "Iris training loss"));
