use external "vraylib/vraylib.vy";
ruleset { dynamic_casting };
fn check(ok :: Bool, message :: String) -> Bool { if !ok { throw message; } return true; }
app :: vraylib.App := vraylib.app_options(64, 64, "shader runtime", 0, vraylib.FLAG_WINDOW_HIDDEN);
good :: vraylib.ShaderBuild := app.compile_shader(null, "#version 330\nout vec4 finalColor; uniform vec4 color; void main()\{ finalColor=color; }");
check(good.success && good.shader.valid(), "candidate shader");
check(good.shader.uniforms().size() > 0, "reflection");
good.shader.set_typed("color", 35666, [2.5, 0.25, -0.5, 1.0]);
bad :: vraylib.ShaderBuild := app.compile_shader(null, "#version 330\nthis is invalid");
check(!bad.success && bad.shader.token == 0 && bad.log.size() > 0 && good.shader.valid(), "failed candidate preserves good shader");
target :: vraylib.RenderTarget := app.float_target(4, 2);
check(target.format() == vraylib.PIXELFORMAT_UNCOMPRESSED_R32G32B32A32, "float format");
app.frame(); target.begin(); app.clear(vraylib.BLACK); good.shader.begin();
vraylib.draw_rectangle(0, 0, 4, 2, vraylib.WHITE);
good.shader.end(); target.end();
pixel :: Array<Float64> := target.read_pixel(0, 0);
check(pixel.size() == 4 && pixel[0] > 2.4 && pixel[2] < -0.4, "HDR readback");
check(target.read_pixels().size() == 32, "full readback");
view :: vraylib.Texture := target.texture(); target.resize(8, 4);
check(view.width() == 8 && target.format() == vraylib.PIXELFORMAT_UNCOMPRESSED_R32G32B32A32, "logical float resize");
replacement :: vraylib.RenderTarget := app.float_target(8, 4);
good.shader.set_typed("color", 35666, [2.5, 0.25, -0.5, 0.25]);
replacement.draw_from(target, good.shader);
target.copy_from(replacement);
identity :: vraylib.ShaderBuild := app.compile_shader(null, "#version 330\nin vec2 fragTexCoord; uniform sampler2D texture0; out vec4 finalColor; void main()\{finalColor=texture(texture0,fragTexCoord);}");
check(identity.success, "identity shader");
replacement.draw_from(target, identity.shader);
pixel = replacement.read_pixel(0, 0);
check(pixel[0] == 2.5 && pixel[2] == -0.5 && pixel[3] == 0.25, "nonopaque replacement identity");
bank :: Array<Int64> := [target.token, replacement.token, good.shader.token, identity.shader.token];
check(app.can_release(bank), "bank preflight");
check(app.can_release_tokens(bank), "token-bank preflight alias");
app.end_frame(); app.release_bank(bank);
check(!target.valid() && !good.shader.valid(), "bank release");
app.close();
check(vraylib.live_handles() == 0, "close cleanup");
out("SHADER_STUDIO_VY_OK");
